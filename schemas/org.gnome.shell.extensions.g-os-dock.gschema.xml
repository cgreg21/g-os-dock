    <key name="indicator-show-focused" type="b"><default>true</default><summary>Show indicator for focused applications</summary></key>
    <key name="indicator-show-minimized" type="b"><default>false</default><summary>Show indicator for minimized applications</summary></key>
  </schema>
</schemalist>
