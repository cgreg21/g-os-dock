{
  "name": "g-os-dock-gnome-extension",
  "version": "0.12.5",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist g-os-dock@cgreg21.github.io.zip",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.json && cp metadata.json stylesheet.css dist/ && mkdir -p dist/schemas && cp schemas/*.gschema.xml dist/schemas/ && glib-compile-schemas --strict dist/schemas",
    "pack": "npm run build && cd dist && zip -qr ../g-os-dock@cgreg21.github.io.zip .",
    "install-local": "npm run pack && gnome-extensions install --force g-os-dock@cgreg21.github.io.zip",
    "dev": "bash scripts/dev-session.sh",
    "dev:watch": "bash scripts/dev-watch.sh",
    "dev:check": "bash scripts/dev-check.sh",
    "dev:install:cachyos": "bash scripts/install-dev-deps-cachyos.sh",
    "dev:install:fedora": "bash scripts/install-dev-deps-fedora.sh",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/*e2e*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@girs/gjs": "^5.6.0",
    "@girs/st-51": "^5.6.0",
    "@girs/clutter-51": "^5.6.0",
    "@girs/shell-51": "^5.6.0",
    "@girs/meta-51": "^5.6.0",
    "@girs/gio-2.0": "^5.6.0",
    "@girs/glib-2.0": "^5.6.0",
    "@girs/gtk-4.0": "^5.6.0",
    "@girs/adw-1": "^5.6.0",
    "@girs/gnome-shell": "^51.0.1"
  }
}
